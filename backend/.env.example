JWT_EXPIRES_IN=1h




# Consulta de CNPJ da farmácia. Valores possíveis: mock | brasilapi
#
# mock: puxa do /farmacia/mock/cnpj-mock.json;
# brasilapi: puxa da BrasilAPI;
# caso o valor fique em branco, o código sempre puxa do mock já que ele é mais garantido.
CNPJ_PROVIDER=mock